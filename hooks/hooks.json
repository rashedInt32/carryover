{
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}\"/hooks/pre-compact.mjs",
            "timeout": 20,
            "statusMessage": "Carryover: writing the ledger"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}\"/hooks/session-start.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
